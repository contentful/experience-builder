{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "module": "Node16",
    "target": "ES2022",
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "dist",
    "forceConsistentCasingInFileNames": true,
    "noEmitOnError": true,
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
