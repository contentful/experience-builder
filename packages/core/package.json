{
  "name": "@contentful/experiences-core",
  "version": "3.8.10",
  "description": "",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contentful/experience-builder.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/contentful/experience-builder/issues"
  },
  "files": [
    "readme.md",
    "package.json",
    "dist/**/*.*"
  ],
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./constants": {
      "import": "./dist/esm/constants.js",
      "require": "./dist/cjs/constants.cjs",
      "default": "./dist/esm/constants.js",
      "types": "./dist/types/constants.d.ts"
    },
    "./types": "./dist/types/index.d.ts"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "typesVersions": {
    "*": {
      "types": [
        "./dist/types/index.d.ts"
      ],
      "constants": [
        "./dist/types/constants.d.ts"
      ]
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "build": "rollup -c ./rollup.config.mjs",
    "predev": "npm run clean",
    "dev": "rollup -c ./rollup.config.mjs --watch --environment DEV",
    "lint": "eslint src --ext '.ts,.tsx,.js,.jsx' --max-warnings 0 --ignore-path ../../.eslintignore",
    "lint:fix": "eslint src --ext '.ts,.tsx,.js,.jsx' --fix",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "depcruise": "depcruise src"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/md5": "2.3.6",
    "@vitest/coverage-v8": "^4.1.10",
    "contentful": "^11.12.7",
    "happy-dom": "^20.11.1",
    "rimraf": "^6.1.3",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-ts": "^3.4.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@contentful/experiences-validators": "file:../validators",
    "@contentful/rich-text-types": "^17.2.7",
    "lodash.clonedeep": "^4.5.0",
    "md5": "2.3.0",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "contentful": ">=10.6.0"
  }
}
