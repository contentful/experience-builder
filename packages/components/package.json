{
  "name": "@contentful/experiences-components-react",
  "version": "3.8.10",
  "description": "A basic set of components to use with Studio Experiences",
  "homepage": "https://github.com/contentful/experience-builder/tree/next/packages/components#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contentful/experience-builder.git",
    "directory": "packages/components"
  },
  "bugs": {
    "url": "https://github.com/contentful/experience-builder/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "scripts": {
    "clean": "rimraf dist",
    "predev": "npm run clean",
    "dev": "rollup -c ./rollup.config.mjs --watch --environment DEV",
    "prebuild": "npm run clean",
    "build": "rollup -c ./rollup.config.mjs",
    "lint": "eslint src --ext '.ts,.tsx,.js,.jsx' --max-warnings 0 --ignore-path ../../.eslintignore",
    "lint:fix": "eslint src --ext '.ts,.tsx,.js,.jsx' --fix",
    "test:component": "npx cypress run --component",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "depcruise": "depcruise src"
  },
  "author": "",
  "license": "MIT",
  "files": [
    "readme.md",
    "package.json",
    "dist/**/*.*"
  ],
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^10.5.6",
    "@storybook/addon-onboarding": "^10.5.6",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^10.5.6",
    "@storybook/react-vite": "^10.5.6",
    "@storybook/testing-library": "^0.2.2",
    "@types/react": "^18.3.31",
    "@vitejs/plugin-react": "^6.0.5",
    "cypress": "^15.20.0",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-ts": "^3.4.5",
    "storybook": "^10.5.6",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vite": "^5.4.8",
    "vite-plugin-svgr": "^5.2.0"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "dependencies": {
    "@contentful/experiences-core": "file:../core",
    "@contentful/rich-text-react-renderer": "^16.2.2",
    "postcss-import": "^16.1.1",
    "style-inject": "^0.3.0"
  }
}
