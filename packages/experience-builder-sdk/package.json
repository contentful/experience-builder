{
  "name": "@contentful/experiences-sdk-react",
  "version": "3.8.10",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "typings": "./dist/src/index.d.ts",
  "type": "module",
  "author": "Contentful GmbH",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contentful/experience-builder.git",
    "directory": "packages/experience-builder-sdk"
  },
  "bugs": {
    "url": "https://github.com/contentful/experience-builder/issues"
  },
  "scripts": {
    "clean": "rimraf dist",
    "predev": "npm run clean",
    "dev": "rollup -c ./rollup.config.mjs --watch --environment DEV",
    "update-dist-version": "node ./bin/injectSDKVersion.cjs & node ./bin/searchAndReplaceSdkVersion.cjs",
    "prepare": "node ./bin/injectSDKVersion.cjs",
    "prebuild": "npm run clean && node ./bin/injectSDKVersion.cjs",
    "build": "rollup -c rollup.config.mjs",
    "postversion": "npm run update-dist-version",
    "watch": "vite build --watch",
    "test": "NODE_ENV=test jest",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:coverage": "NODE_ENV=test jest --coverage --maxWorkers 2",
    "tsc": "tsc --noEmit",
    "lint": "eslint ./src --ext '.ts,.tsx,.js,.jsx'",
    "presemantic-release": "npm run build",
    "semantic-release": "semantic-release",
    "prettier:check": "prettier --check '**/*.{jsx,js,ts,tsx,css}'",
    "prettier": "prettier --write '**/*.{jsx,js,ts,tsx,css}'",
    "preview": "vite preview",
    "depcruise": "depcruise src"
  },
  "dependencies": {
    "@contentful/experiences-components-react": "file:../components",
    "@contentful/experiences-core": "file:../core",
    "@contentful/experiences-validators": "file:../validators",
    "@contentful/experiences-visual-editor-react": "file:../visual-editor",
    "@contentful/rich-text-types": "^17.2.7",
    "csstype": "^3.1.2",
    "immer": "^10.0.3",
    "md5": "^2.3.0",
    "style-inject": "^0.3.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-typescript": "^11.1.6",
    "@semantic-release/changelog": "^6.0.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/md5": "^2.3.6",
    "@types/node": "^20.19.43",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "contentful": "^11.10.2",
    "glob": "^10.5.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^24.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "relative-deps": "^1.0.7",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-node-externals": "^7.1.3",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "semantic-release": "^25.0.8",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "vite": "^5.4.8",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-svgr": "^4.5.0"
  },
  "peerDependencies": {
    "contentful": ">=10.6.0",
    "react": ">=16.0.0",
    "react-dom": ">=16.0.0"
  },
  "files": [
    "dist",
    "package.json"
  ]
}
